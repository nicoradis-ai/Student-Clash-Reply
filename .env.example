# Copia questo file in .env (che git ignora) e scegli UN blocco. Senza niente l'app gira offline.

# --- Gemini, piano gratuito (consigliato per sviluppare): chiave da https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# EMBED_MODEL=gemini-embedding-001

# --- Ollama sul tuo PC (gratis, senza rete): ollama pull qwen2.5:7b && ollama pull nomic-embed-text
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# EMBED_MODEL=nomic-embed-text

# --- Chat su Gemini, embedding su Ollama (così gli embedding non consumano il limite gratuito)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# EMBED_PROVIDER=ollama

# --- OpenAI (come all'hackathon)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-6-luna

# --- Qualsiasi altro servizio compatibile con l'API OpenAI (Groq, OpenRouter, LM Studio, ...)
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=
# EMBED_PROVIDER=offline     # Groq e OpenRouter non hanno embedding: usa quelli locali

# Soglia del RAG (coseno). 0.25 è tarata su OpenAI; con altri embedding filtra meno, alzala se cita pagine fuori tema.
# RAG_MIN_SIM=0.25
